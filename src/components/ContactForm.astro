---
// Form submissions are emailed to you by Web3Forms (web3forms.com), a free
// service. The access key below is tied to your inbox; it's designed to be
// public, so it's safe in the page.
const ACCESS_KEY = "5834a275-be06-42de-96fc-01756b1bdfa9";

interface Props { pulseOnly?: boolean; }
const { pulseOnly = false } = Astro.props;
---
<form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value={ACCESS_KEY} />
  <input type="hidden" name="subject" value={pulseOnly ? "New Santa Fe Pulse sign-up" : "New message from dunmahon.com"} />
  <input type="hidden" name="from_name" value="dunmahon.com" />
  <input type="hidden" name="redirect" value="" data-next />
  <input type="checkbox" name="botcheck" class="honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <label>Name
    <input type="text" name="name" required autocomplete="name" />
  </label>
  <label>Email
    <input type="email" name="email" required autocomplete="email" />
  </label>

  {pulseOnly ? (
    <input type="hidden" name="Santa Fe Pulse" value="Yes, sign me up" />
  ) : (
    <>
      <label>Message
        <textarea name="message" rows="5"></textarea>
      </label>
      <label class="check">
        <input type="checkbox" name="Santa Fe Pulse" value="Yes, sign me up" />
        <span>Sign me up for <strong>Santa Fe Pulse</strong>, the free daily magazine about life in Santa Fe.</span>
      </label>
    </>
  )}

  <button class="button" type="submit">{pulseOnly ? "Subscribe" : "Send"}</button>
</form>

<script>
  // After sending, return visitors to this site's thank-you page.
  document.querySelectorAll<HTMLInputElement>("[data-next]").forEach((el) => {
    el.value = `${location.origin}/thanks`;
  });
</script>
