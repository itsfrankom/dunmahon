---
import type { PortfolioItem } from "../data/portfolio";

interface Props { item: PortfolioItem; publishedPieces: Set<string>; }
const { item, publishedPieces } = Astro.props;

// Work hosted on this site links to its own page once that page is published.
const links = [...(item.links ?? [])];
if (item.piece && publishedPieces.has(item.piece)) {
  links.push({ label: "Read it here", url: `/${item.piece}` });
}
const external = (url: string) => /^https?:/.test(url);
---
<article class="card" data-category={item.category}>
  {item.image && (
    <div class:list={["thumb", { logo: item.logo, portrait: item.portrait }]}>
      <img src={item.image} alt="" loading="lazy" style={item.imagePosition ? `object-position: ${item.imagePosition}` : undefined} onerror="this.parentElement.remove()" />
    </div>
  )}
  <div class="body">
    <div class="meta">{item.client}</div>
    <h3>{item.title}</h3>
    {item.description && <p>{item.description}</p>}
    {links.length > 0 && (
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.url} target={external(l.url) ? "_blank" : undefined} rel={external(l.url) ? "noopener" : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
