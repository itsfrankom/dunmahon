---
import Base from "../layouts/Base.astro";
---
<Base title="Maureen's Minute" description="Sample short-form video produced for Maureen McCarthy, RE/MAX of Boulder.">
  <div class="wrap">
    <article class="intro prose">
      <div class="eyebrow">Maureen McCarthy, RE/MAX of Boulder</div>
      <h1>Maureen's Minute</h1>
      <p>Sample short-form videos for a top 1.5% Boulder agent, built to attract both buyers and sellers.</p>
      <video class="hero video" controls playsinline preload="metadata" poster="/video/maureens-minute-poster.webp">
        <source src="/video/maureens-minute.mp4" type="video/mp4" />
      </video>
      <p><a href="/portfolio">← Back to portfolio</a></p>
    </article>
  </div>
</Base>
