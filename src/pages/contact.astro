---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";
---
<Base title="Contact" description="Get in touch with Frank O'Mahony, or sign up for Santa Fe Pulse.">
  <div class="wrap">
    <section class="intro prose">
      <div class="eyebrow">Contact</div>
      <h1>Let's talk.</h1>
      <p>Working on content, social media or a story that needs telling? Send a note and I'll get back to you.</p>
    </section>

    <div class="contact-layout">
      <ContactForm />

      <aside class="contact-aside">
        <div class="aside-block">
          <h3>Santa Fe real estate</h3>
          <p>Thinking of buying or selling in Santa Fe? Market information, listings and more at my real estate site.</p>
          <a class="button ghost" href="https://santafefrank.com" target="_blank" rel="noopener">santafefrank.com</a>
        </div>
        <div class="aside-block">
          <h3>Reach me directly</h3>
          <p><a href={`tel:${site.phoneLink}`}>{site.phone}</a></p>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p><a href="https://linkedin.com/in/itsfrankomahony" target="_blank" rel="noopener">LinkedIn</a></p>
        </div>
      </aside>
    </div>
  </div>
</Base>
