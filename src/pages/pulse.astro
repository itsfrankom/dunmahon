---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
---
<Base title="Santa Fe Pulse" description="Sign up for Santa Fe Pulse, a free daily magazine about Santa Fe: events, real estate, history, jobs, film and city government.">
  <div class="wrap">
    <section class="intro prose">
      <a href="https://pulse.santafefrank.com" target="_blank" rel="noopener" class="pulse-logo">
        <img src="/images/santa-fe-pulse-logo.png" alt="Santa Fe Pulse" width="400" height="95" />
      </a>
      <h1>Santa Fe, every morning.</h1>
      <p>A free daily magazine about Santa Fe: arts, real estate, history, work, film and city hall, delivered to your inbox. <a href="https://pulse.santafefrank.com" target="_blank" rel="noopener">Read today's issue</a>.</p>
    </section>
    <div class="contact-layout single">
      <ContactForm pulseOnly />
    </div>
  </div>
</Base>
